+
+def _strip_ephemeral_memory(messages: list) -> list:
+    """Return a transcript copy with memory packs removed."""
+    cleaned = []
+    for message in messages or []:
+        if not isinstance(message, dict):
+            cleaned.append(message)
+            continue
+        item = dict(message)
+        content = item.get("content")
+        if isinstance(content, str) and "<memory-context>" in content:
+            item["content"] = _EPHEMERAL_MEMORY_RE.sub("", content).strip()
+        cleaned.append(item)
+    return cleaned
