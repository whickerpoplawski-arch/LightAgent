+# Ephemeral profile/memory packs use this wrapper. Session transcripts drop it
+# so a pack cannot be replayed as chat content. See local/memory/README.md.
+_EPHEMERAL_MEMORY_RE = re.compile(r"<memory-context>.*?</memory-context>\s*", re.DOTALL)
