/* 图片样式壳：白卡片、浅灰侧栏、圆角胶囊。气泡正文是 PNG，不靠这里填色。 */

Screen { background: #e8e8ed; color: #1c1c1e; }
#shell {
    height: 100%;
    background: #ffffff;
    border: round #e5e5ea;
}

/* ---------- Sidebar ---------- */
#sidebar {
    width: 36;
    background: #f5f5f7;
    border-right: none;
    padding: 1 1 0 1;
}
#side-top { height: 3; padding: 0 1; }
#brand { width: 1fr; height: 3; text-style: bold; content-align: left middle; color: #1c1c1e; }
#new-btn {
    width: 5; height: 3;
    content-align: center middle;
    background: #2f7cf6;
    color: #ffffff;
    border: round #2f7cf6;
    text-style: bold;
}
#new-btn:hover { background: #2563eb; color: #ffffff; border: round #2563eb; }

#search {
    height: 3;
    margin: 0 0 1 0;
    background: #eeeeef;
    border: round #eeeeef;
    padding: 0 1;
    color: #3a3a3c;
}
#search:focus { border: round #2f7cf6; background: #ffffff; }

#pinned-list, #project-list, #room-list, #ungrouped-list {
    height: auto;
}
#nav {
    background: transparent;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-color: #d4d4d8;
    scrollbar-background: #f5f5f7;
    padding: 0 0 1 0;
}
.nav-section {
    height: 1;
    margin: 1 1 0 1;
    color: #8e8e93;
    text-style: bold;
}
.nav-action {
    height: 3;
    margin: 0 1 1 1;
    padding: 0 1;
    color: #3b82f6;
    border: round #d4d4d8;
    background: transparent;
    content-align: left middle;
}
.nav-action:hover { border: round #a1a1aa; }
.project-row {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
}
.project-head, .project-title, .project-add { display: none; }
.session-row {
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0;
    background: transparent;
    border: none;
}
.session-row.nested {
    margin-left: 0;
    padding: 0 1;
    min-height: 2;
}
.session-row.nested .s-preview { display: block; height: 1; color: #8e8e93; }
.session-row:hover { background: #efeff2; }
.session-row.selected { background: #e8e8ed; }
.session-row .s-avatar {
    content-align: center middle;
    background: transparent;
    color: #ffffff;
    border: none;
    margin-right: 1;
    margin-top: 0;
}
.session-row .s-meta { width: 1fr; height: auto; padding: 0; content-align: left middle; }
.session-row .s-title { text-style: bold; height: 1; color: #1c1c1e; }
.session-row .s-preview { color: #8e8e93; height: 1; }
.session-row.unread .s-title { text-style: bold; color: #3b82f6; }
.session-row.is-hidden { color: #8e8e93; }
.nav-disabled {
    height: 3;
    margin: 0 1 1 1;
    padding: 0 1;
    color: #aeaeb2;
    border: round #e5e5ea;
    background: transparent;
    content-align: left middle;
}
#room-list { height: auto; }
#room-members { height: 8; margin: 0 0 1 0; }
#room-form-error { height: 1; color: #dc2626; }
.speaker-label {
    width: 12;
    height: 1;
    margin: 1 0 0 1;
    text-style: bold;
    color: #3b82f6;
}
.speaker-label.host { color: #6366f1; }
.speaker-label.bot { color: #ea580c; }
.speaker-label.system { color: #8e8e93; }

#menu-dialog, #identity-dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #ffffff;
    border: round #d4d4d8;
    margin: 1 2;
}
#identity-dialog { height: 90%; }
#identity-form { height: 1fr; }
#menu-title { text-style: bold; height: 1; color: #1c1c1e; }
.notice-line {
    color: #3b82f6;
    margin: 0 2 1 2;
}
#menu-hint { color: #8e8e93; height: auto; margin: 0 0 1 0; }
#menu-buttons { height: 3; margin-top: 1; }
#menu-buttons Button { margin-right: 1; }
#identity-job, #identity-persona { height: 5; margin-bottom: 1; }
#identity-role, #identity-display, #identity-template, #identity-persona-mode { margin-bottom: 1; }

#side-foot {
    height: 3;
    padding: 0 1;
    border-top: solid #ececf0;
}
#profile-dot {
    width: 3; height: 1;
    margin-top: 1;
    color: #3b82f6;
    text-style: bold;
}
#profile-label { width: 1fr; color: #8e8e93; height: 3; content-align: left middle; }

/* ---------- Main ---------- */
#main { width: 1fr; background: #ffffff; }

#header {
    height: 3;
    padding: 1 2 0 2;
    align-vertical: middle;
    background: #ffffff;
    border-bottom: none;
}
#h-avatar {
    margin-right: 1;
    background: transparent;
    border: none;
    content-align: center middle;
}
#h-title { width: 1fr; color: #1c1c1e; }
#h-model { width: auto; color: #aeaeb2; }

/* ---------- Tabs ---------- */
#tabs {
    height: 1fr;
    background: #ffffff;
}
#tabs > ContentSwitcher { height: 1fr; background: #ffffff; }
TabPane { padding: 0; background: #ffffff; }
UnderlineTabBar {
    background: #ffffff;
    padding: 0 2;
    height: 3;
    border-bottom: none;
}
Tab {
    color: #8e8e93;
    background: transparent;
    padding: 0 2;
}
Tab.-active {
    color: #3b82f6;
    text-style: bold;
    background: transparent;
}
UnderlineTabBar > .underline--bar {
    color: #3b82f6;
    background: #e5e5ea;
}

#chat {
    height: 1fr;
    padding: 1 3 0 3;
    background: #ffffff;
    scrollbar-size-vertical: 1;
    scrollbar-color: #d4d4d8;
    scrollbar-color-hover: #a1a1aa;
    scrollbar-color-active: #8e8e93;
    scrollbar-background: #ffffff;
    scrollbar-background-hover: #ffffff;
    scrollbar-background-active: #ffffff;
}

.empty {
    color: #aeaeb2;
    content-align: center middle;
    height: auto;
    width: 100%;
    background: transparent;
    border: round #e5e5ea;
    margin: 2 8;
    padding: 1 2;
}

.user-row, .agent-row, .tool-row, .error-row {
    height: auto;
    width: 100%;
    background: transparent;
}

/* 对话内 blob：真图，尺寸由像素对齐，不在这里拉宽 */
.msg-avatar {
    content-align: center middle;
    background: transparent;
    border: none;
    margin: 0 1 0 0;
    padding: 0;
}

.user-row { align-horizontal: right; margin: 1 1 1 4; height: auto; }
.agent-row {
    align-horizontal: left;
    align-vertical: top;
    margin: 1 4 1 0;
    height: auto;
}
.soft-bubble {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

.tool-row { align-horizontal: left; margin: 1 10 0 2; }
.tool-line {
    width: auto;
    height: auto;
    background: transparent;
    color: #8e8e93;
    text-style: italic;
    padding: 0 2;
    border: round #e5e5ea;
    margin: 0 0 0 0;
}
.error-row { align-horizontal: left; margin: 1 10 0 2; }
/* 不要给 .soft-bubble 设 opacity。TGP 把图像 id 编进前景色，半透明会把它染灰。 */
.chat-bubble.chat-focused > .tool-line { border: round #fb923c; text-style: bold; }
.chat-bubble.chat-focused > .error-line { border: round #f87171; }

.error-line {
    width: auto;
    height: auto;
    background: transparent;
    color: #dc2626;
    padding: 0 2;
    border: round #fecaca;
}

/* ---------- Trace pane ---------- */
#trace-pane {
    height: 1fr;
    background: #f5f5f7;
    padding: 0 2 0 2;
}
#trace-meta {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
    background: transparent;
}
#tm-dur, #tm-rounds, #tm-calls {
    width: auto;
    margin-right: 2;
    color: #8e8e93;
    padding: 0 1;
    border: round #e5e5ea;
    background: transparent;
}
#tm-calls:hover { border: round #fb923c; color: #ea580c; }
#trace-search {
    width: 1fr;
    background: transparent;
    border: round #d4d4d8;
    padding: 0 1;
}
#trace-search:focus { border: round #3b82f6; background: transparent; }

#timeline {
    height: auto;
    margin: 0 1 1 1;
    padding: 0 1;
    background: transparent;
    border: round #e5e5ea;
    color: #1c1c1e;
}
.tl-lane {
    height: 1;
    width: 100%;
    background: transparent;
    color: #1c1c1e;
    layout: horizontal;
}
.tl-lane:hover { background: #efeff2; }
.tl-lane.active { background: #e8e8ed; text-style: bold; }
.tl-label {
    width: 5;
    height: 1;
    background: transparent;
}
.tl-label:hover { text-style: bold underline; }
.tl-block {
    height: 1;
    background: transparent;
}
.tl-block:hover { opacity: 80%; text-style: bold; }
.tl-gap {
    height: 1;
    background: transparent;
    color: #d4d4d8;
}
#tm-filter {
    width: 1fr;
    color: #8e8e93;
    content-align: left middle;
}

#trace-feed {
    height: 1fr;
    padding: 0 1 1 1;
    background: #f5f5f7;
    scrollbar-size-vertical: 1;
    scrollbar-color: #d4d4d8;
    scrollbar-background: #f5f5f7;
}
.trace-row {
    height: auto;
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1;
    background: transparent;
    border: round #e5e5ea;
    color: #1c1c1e;
}
.trace-row.err { border: round #fecaca; }
.trace-row:hover { border: round #d4d4d8; }
.trace-row.selected {
    border: round #3b82f6;
    text-style: bold;
}
.trace-row:focus { border: round #2563eb; }

.trace-empty {
    color: #aeaeb2;
    content-align: center middle;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    border: round #e5e5ea;
    background: transparent;
}

#thinking { height: 1; padding: 0 3; color: #6366f1; text-style: italic; }

#composer {
    height: 3;
    margin: 0 2 0 2;
    padding: 0 1;
    background: #ffffff;
    border: round #e3e3e8;
}
#composer:focus-within { border: round #2f7cf6; }
#attach-hint { display: none; }
#prompt { width: 1fr; height: 1; background: transparent; border: none; padding: 0 1; color: #1c1c1e; }
#prompt:focus { border: none; background: transparent; }
#send-hint { display: none; }

#context-dock {
    display: none;
    height: auto;
    width: 100%;
    padding: 0 2 0 0;
    align-horizontal: right;
    background: transparent;
}
#ctx-spacer { width: 1fr; height: 1; background: transparent; }
#context-popover {
    width: 36;
    height: auto;
    margin: 0 0 0 0;
    padding: 0 1;
    background: #ffffff;
    border: round #d4d4d8;
    color: #1c1c1e;
}
#ctx-head {
    height: 1;
    width: 100%;
}
#ctx-title { width: 1fr; color: #1c1c1e; text-style: bold; }
#ctx-used { width: auto; color: #8e8e93; content-align: right middle; }
#ctx-bar {
    height: 1;
    width: 100%;
    margin: 0 0;
    color: #1c1c1e;
}
#ctx-rows {
    height: auto;
    width: 100%;
    color: #1c1c1e;
}

#stats-bar {
    dock: bottom;
    height: 3;
    width: 100%;
    padding: 0 2;
    background: #ffffff;
    color: #8e8e93;
    align-vertical: middle;
}
#stats {
    width: 1fr;
    height: 3;
    color: #8e8e93;
    content-align: left middle;
}
#ctx-pct {
    width: auto;
    height: 3;
    min-width: 8;
    padding: 0 1;
    color: #636366;
    text-style: bold;
    background: #f2f2f4;
    border: round #e5e5ea;
    content-align: center middle;
}
#ctx-pct:hover { border: round #d4d4d8; color: #3a3a3c; }

#settings-gear {
    width: 3;
    height: 3;
    content-align: center middle;
    color: #8e8e93;
    background: transparent;
    border: round #f5f5f7;
}
#settings-gear:hover {
    color: #3b82f6;
    border: round #d4d4d8;
}

SettingsScreen {
    background: #1c1c1e66;
    align: center middle;
}
#settings-shell {
    width: 96%;
    height: 92%;
    background: #f5f5f7;
    border: round #d4d4d8;
}
#settings-nav {
    width: 32;
    background: #efeff2;
    border-right: solid #e5e5ea;
    padding: 1;
}
#settings-nav-top {
    height: 3;
    margin-bottom: 1;
}
#settings-back {
    width: 3;
    height: 3;
    content-align: center middle;
    color: #3b82f6;
    border: round #d4d4d8;
    margin-right: 1;
}
#settings-back:hover { border: round #a1a1aa; }
#settings-filter {
    width: 1fr;
    background: transparent;
    border: round #d4d4d8;
    padding: 0 1;
}
#settings-filter:focus { border: round #3b82f6; }
.settings-nav-item {
    height: 3;
    padding: 0 1;
    margin: 0 0 1 0;
    color: #3a3a3c;
    border: round #efeff2;
    content-align: left middle;
}
.settings-nav-item:hover { border: round #d4d4d8; }
.settings-nav-item.selected {
    background: #e8e8ed;
    border: round #e8e8ed;
    text-style: bold;
    color: #1c1c1e;
}
#settings-nav-foot {
    dock: bottom;
    height: 3;
    border-top: solid #e5e5ea;
    padding: 0 1;
}
#settings-profile-dot {
    width: 3;
    color: #3b82f6;
    text-style: bold;
    content-align: center middle;
    height: 3;
}
#settings-profile-label {
    width: 1fr;
    color: #8e8e93;
    height: 3;
    content-align: left middle;
}
#settings-nav-gear {
    width: 3;
    height: 3;
    content-align: center middle;
    color: #8e8e93;
}

#settings-main {
    width: 1fr;
    background: #f5f5f7;
    padding: 1 2;
}
#settings-title {
    text-style: bold;
    height: 2;
    color: #1c1c1e;
}
#settings-subtitle {
    color: #8e8e93;
    height: 2;
    margin-bottom: 1;
}
#plugin-install {
    margin: 0 0 1 0;
    background: transparent;
    border: round #d4d4d8;
    padding: 0 1;
}
#plugin-install:focus { border: round #3b82f6; }
#plugin-status {
    height: 2;
    color: #3b82f6;
    margin-bottom: 1;
}
#plugin-list {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
}
.plugin-row {
    height: 5;
    margin: 0 0 1 0;
    padding: 0 1;
    background: transparent;
    border: round #e5e5ea;
}
.plugin-row:hover { border: round #d4d4d8; }
.plugin-icon {
    width: 4;
    height: 5;
    content-align: center middle;
}
.plugin-meta {
    width: 1fr;
    height: 5;
    padding: 1 1 0 0;
}
.plugin-title {
    text-style: bold;
    height: 1;
    color: #1c1c1e;
}
.plugin-desc {
    color: #8e8e93;
    height: 2;
}
.plugin-switch {
    width: 10;
    height: 5;
    content-align: center middle;
}
.plugin-empty {
    color: #8e8e93;
    padding: 2;
    border: round #e5e5ea;
    margin: 1;
}

.memory-panel { height: 100%; padding: 1 2; }
.mem-hint { height: 1; color: #8e8e93; margin: 0 0 1 0; }
#mem-list { height: 1fr; border: round #d4d4d8; background: transparent; }
.mem-actions { height: 3; margin: 1 0 0 0; }
.mem-actions Button { margin: 0 1 0 0; }
#mem-status { height: 2; color: #3a3a3c; }
#tab-memory Input { margin: 0 0 1 0; }

Button {
    background: transparent;
    color: #3b82f6;
    border: round #d4d4d8;
}
Button:hover { border: round #3b82f6; color: #2563eb; }
Input {
    background: transparent;
    border: round #d4d4d8;
    color: #1c1c1e;
}
Input:focus { border: round #3b82f6; background: transparent; }
TextArea {
    background: transparent;
    border: round #d4d4d8;
    color: #1c1c1e;
}
TextArea:focus { border: round #3b82f6; }
Select {
    background: transparent;
    border: round #d4d4d8;
    color: #1c1c1e;
}
Select:focus { border: round #3b82f6; }


/* 头像 / 气泡 PNG：宽高由 graphics.fit_graphics_widget 按像素锁定。 */
.h-avatar, .s-avatar, .msg-avatar, .soft-bubble {
    background: transparent;
    border: none;
    padding: 0;
}
